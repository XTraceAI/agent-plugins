{
  "description": "MemHub compatibility hooks for Codex releases without plugin-bundled hook loading.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch|Bash|shell|local_shell)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "statusMessage": "MemHub: checking for relevant directives",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch PreToolUse",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch|shell|local_shell|Bash)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 16,
            "statusMessage": "MemHub: checking memory context",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch PostToolUse",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch Stop",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch Stop"
          }
        ]
      }
    ]
  }
}
