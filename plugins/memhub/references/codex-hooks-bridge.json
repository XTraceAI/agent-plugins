{
  "description": "MemHub hooks for Codex. Codex 0.163 removed plugin-bundled hook loading, so these user-level hooks are the only MemHub hooks Codex runs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch SessionStart",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch SessionStart",
            "statusMessage": "MemHub: orienting this session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch UserPromptSubmit",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch UserPromptSubmit",
            "statusMessage": "MemHub: checking team rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch|Bash|shell|local_shell|exec_command|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "statusMessage": "MemHub: checking team rules",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch PreToolUse",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch|shell|local_shell|exec_command|shell_command|Bash)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 16,
            "statusMessage": "MemHub: checking memory context",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch PostToolUse",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch Stop",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" dispatch SessionEnd",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" dispatch SessionEnd",
            "statusMessage": "MemHub: closing the session"
          }
        ]
      }
    ]
  }
}
