{
  "description": "MemHub compatibility hooks for Codex releases without plugin-bundled hook loading.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "statusMessage": "MemHub: checking for relevant directives",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" directive-pre",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" directive-pre"
          }
        ]
      },
      {
        "matcher": "Bash|shell|local_shell",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "statusMessage": "MemHub: checking for relevant directives",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" directive-pre",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" directive-pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch|shell|local_shell|Bash)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "statusMessage": "MemHub: checking directives for this failure",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" directive-post",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" directive-post"
          }
        ]
      },
      {
        "matcher": "^(Edit|MultiEdit|Write|NotebookEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "statusMessage": "MemHub: checking artifact links",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" artifact-sync",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" artifact-sync"
          }
        ]
      },
      {
        "matcher": "Bash|shell|local_shell",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "statusMessage": "MemHub: flushing session memory",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" flush PostToolUse",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" flush PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/memhub_hook_bridge.py\" flush Stop",
            "commandWindows": "py -3 \"%CODEX_HOME%\\memhub_hook_bridge.py\" flush Stop"
          }
        ]
      }
    ]
  }
}
