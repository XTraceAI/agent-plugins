{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" beforeShellExecution"
      }
    ],
    "afterFileEdit": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" afterFileEdit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" afterAgentResponse"
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" stop"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" beforeSubmitPrompt"
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" sessionEnd"
      }
    ]
  }
}
