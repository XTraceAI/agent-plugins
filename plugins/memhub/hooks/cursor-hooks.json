{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" sessionStart"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" beforeShellExecution"
      }
    ],
    "afterShellExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" afterShellExecution"
      }
    ],
    "afterFileEdit": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" afterFileEdit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" afterAgentResponse"
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" stop"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" beforeSubmitPrompt"
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" sessionEnd"
      }
    ],
    "subagentStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" subagentStart"
      }
    ],
    "subagentStop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" subagentStop"
      }
    ],
    "preToolUse": [
      {
        "matcher": "Read|Task|Write|Edit|StrReplace|MultiEdit|search_replace",
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" preToolUse"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Task|Shell|Write|Edit|StrReplace|MultiEdit|search_replace",
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" postToolUse"
      }
    ],
    "postToolUseFailure": [
      {
        "matcher": "Shell",
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" postToolUseFailure"
      }
    ],
    "beforeReadFile": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor_capture.cmd\" beforeReadFile"
      }
    ]
  }
}
