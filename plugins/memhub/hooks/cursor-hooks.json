{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./hooks/cursor_capture.cmd beforeShellExecution"
      }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/cursor_capture.cmd afterFileEdit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "./hooks/cursor_capture.cmd afterAgentResponse"
      }
    ],
    "stop": [
      {
        "command": "./hooks/cursor_capture.cmd stop"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/cursor_capture.cmd beforeSubmitPrompt"
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/cursor_capture.cmd sessionEnd"
      }
    ]
  }
}
